      'eventName': 'Lead',
      'currency': 'CZK',
      'usingConsentModeV2': true,
      'eventId': 'EVENT_ID_2'
    };

    runCode(firstEvent);
    runCode(secondEvent);

    assertApi('callInWindow').wasNotCalled();

    // sul js finished loading -> queue is flushed
    loadScriptCallback();

